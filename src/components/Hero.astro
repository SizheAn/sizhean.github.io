---
import { profile } from '../data/profile';

const { positioning, scholarBadge } = profile;
---

<section class="hero" id="top">
  <div class="hero__copy">
    <p class="eyebrow">
      <span data-edit="profile.role">{profile.role}</span> ·
      <span data-edit="profile.affiliation">{profile.affiliation}</span> ·
      <span data-edit="profile.location">{profile.location}</span>
    </p>
    <h1 data-edit="profile.name">{profile.name}</h1>
    <p class="hero__lead" data-edit="profile.positioning.lead">{positioning.lead}</p>
    <p class="hero__statement" data-edit="profile.positioning.statement">{positioning.statement}</p>
    <p class="hero__foundation" data-edit="profile.positioning.foundation">
      {positioning.foundation}
    </p>

    <div class="link-row" aria-label="Profile links">
      {
        profile.links.map((link) =>
          link.pending ? (
            <span class="chip chip--pending" title={link.note}>
              {link.label}
              <em>soon</em>
            </span>
          ) : (
            <a class="chip" href={link.href}>
              {link.label}
            </a>
          ),
        )
      }
    </div>

    {/* Always in the DOM so the editor can reveal it once a count is set. */}
    <a class="scholar-badge" href={scholarBadge.href} data-scholar hidden={scholarBadge.count === undefined}>
      <span>{scholarBadge.label}</span>
      <strong data-scholar-count>{scholarBadge.count ?? ''}</strong>
    </a>
  </div>

  <figure class="hero__portrait">
    <img src={profile.portrait} alt={profile.portraitAlt} width="480" height="480" />
  </figure>
</section>

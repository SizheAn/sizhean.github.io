---
import { profile } from '../data/profile';
import { featuredWork, venueTally } from '../data/publications';

const { positioning, scholarBadge, github } = profile;
const venues = venueTally();
const marquee = featuredWork.slice(0, 3);
const years = new Date().getFullYear() - profile.since.year;
---

<section class="hero" id="top">
  <div class="hero__copy">
    <p class="eyebrow">{profile.role} · {profile.affiliation} · {profile.location}</p>
    <h1>{profile.name}</h1>
    <p class="hero__lead">{positioning.lead}</p>
    <p class="hero__statement">{positioning.statement}</p>
    <p class="hero__bridge">{profile.bridge}</p>

    <ul class="metrics" aria-label="Publication record">
      {
        scholarBadge.count !== undefined && (
          <li>
            <a href={scholarBadge.href}>
              {scholarBadge.count.toLocaleString('en-US')} citations
            </a>
          </li>
        )
      }
      {venues.map((venue) => <li>{venue.label}{venue.count > 1 && ` ×${venue.count}`}</li>)}
      <li>
        <a href={github.repo}>{github.label} ★{github.stars.toLocaleString('en-US')}</a>
      </li>
      <li>{years} yrs @ {profile.since.label}</li>
    </ul>

    <div class="link-row" aria-label="Profile links">
      {profile.links.map((link) => <a class="chip" href={link.href}>{link.label}</a>)}
    </div>
  </div>

  <div class="hero__marquee" aria-hidden="true">
    {
      marquee.map((publication) => (
        <a href={`#${publication.slug}`}>
          <img src={publication.media.poster ?? publication.media.src} alt="" loading="eager" />
          <span>{publication.shortTitle}</span>
        </a>
      ))
    }
  </div>
</section>

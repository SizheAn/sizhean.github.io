---
import { profile } from '../data/profile';

interface Props {
  editable?: boolean;
}

const { editable = false } = Astro.props;
const { scholarBadge } = profile;
const hook = <T,>(value: T) => (editable ? value : undefined);
---

<section class="hero" id="top">
  <div class="hero__copy">
    <h1>{profile.name}</h1>
    <p class="hero__lead" data-edit={hook('profile.positioning')}>{profile.positioning}</p>

    <div class="link-row" aria-label="Profile links">
      {
        profile.links.map((link) =>
          link.pending ? (
            <span class="chip chip--pending" title={link.note}>
              {link.label}
              <em>soon</em>
            </span>
          ) : (
            <a class="chip" href={link.href}>
              {link.label}
            </a>
          ),
        )
      }
    </div>

    {
      (editable || scholarBadge.count !== undefined) && (
        <a
          class="scholar-badge"
          href={scholarBadge.href}
          data-scholar={hook('')}
          hidden={scholarBadge.count === undefined || undefined}
        >
          <span>{scholarBadge.label}</span>
          <strong data-scholar-count={hook('')}>{scholarBadge.count?.toLocaleString('en-US')}</strong>
        </a>
      )
    }
  </div>

  <figure class="hero__portrait">
    <img src={profile.portrait} alt={profile.portraitAlt} width="480" height="480" />
  </figure>
</section>

---
import AuthorList from './AuthorList.astro';
import type { Publication } from '../data/publications';

interface Props {
  publication: Publication;
  /** Adds the editor's hooks: field keys and per-paper controls. */
  editable?: boolean;
  /** Edit mode only: rendered but hidden while the paper sits in Selected work. */
  hidden?: boolean;
}

const { publication, editable = false, hidden = false } = Astro.props;
const { slug } = publication;
const hook = <T,>(value: T) => (editable ? value : undefined);
// The edit-only controls are glued to the links (`}{`): on a line of their own
// they would leave a stray space in the public markup.
---

<li data-pub={hook(slug)} data-place={hook('earlier')} hidden={(editable && hidden) || undefined}>
  {
    editable ? (
      <span class="pill"><span data-edit={`pub.${slug}.venue`}>{publication.venue}</span> <span data-edit={`pub.${slug}.year`}>{publication.year}</span></span>
    ) : (
      <span class="pill">{publication.venue} {publication.year}</span>
    )
  }
  <div>
    <p class="pub-list__title" data-edit={hook(`pub.${slug}.title`)}>{publication.title}</p>
    <AuthorList authors={publication.authors} class="pub-list__authors" edit={hook(`pub.${slug}.authors`)} />
  </div>
  <div class="link-row link-row--tight">
    {publication.links.map((link) => (
      <a class="chip chip--sm" href={link.href}>
        {link.label}
      </a>
    ))}{
      editable && (
        <span class="pub-controls pub-controls--inline" data-controls hidden>
          <button type="button" data-move="up" title="Move up">↑</button>
          <button type="button" data-move="down" title="Move down">↓</button>
          <button type="button" data-lead-toggle title="Toggle ★ Project lead">★ Lead</button>
          <button type="button" data-place-toggle title="Move to Selected work">Feature</button>
        </span>
      )
    }
  </div>
</li>

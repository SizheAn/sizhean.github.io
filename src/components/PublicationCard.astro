---
import { AUTHOR_NAME, authorRole, isPeerReviewed, shortAuthors } from '../data/publications';
import type { Publication } from '../data/publications';

interface Props {
  publication: Publication;
}

const { publication } = Astro.props;
const { media } = publication;
const primaryHref = publication.links[0]?.href;
const role = authorRole(publication);
const refereed = isPeerReviewed(publication);
// Split rather than string-replace so the author name is emphasized as markup.
const authorParts = shortAuthors(publication.authors).split(AUTHOR_NAME);
---

<article class="tile" id={publication.slug}>
  <div class="tile__media">
    {
      media.type === 'video' ? (
        <video
          src={media.src}
          poster={media.poster}
          playsinline
          muted
          loop
          preload="none"
          aria-label={media.alt}
          data-autoplay
        />
      ) : (
        <img src={media.src} alt={media.alt} loading="lazy" decoding="async" />
      )
    }
  </div>

  <div class="tile__body">
    <div class="tile__meta">
      <span class:list={['pill', refereed ? 'pill--refereed' : 'pill--preprint']}>
        {publication.venue} {publication.year}
      </span>
      <span class:list={['role', role.strong && 'role--strong']}>{role.label}</span>
    </div>

    <h3>
      {primaryHref ? <a href={primaryHref}>{publication.title}</a> : publication.title}
    </h3>

    <p class="tile__authors" title={publication.authors}>
      {
        authorParts.map((part, index) => (
          <>
            {index > 0 && <strong>{AUTHOR_NAME}</strong>}
            {part}
          </>
        ))
      }
    </p>

    <p class="tile__contribution">{publication.contribution}</p>

    <div class="link-row link-row--tight">
      {publication.links.map((link) => <a class="chip chip--sm" href={link.href}>{link.label}</a>)}
    </div>
  </div>
</article>

---
---

<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
>
  <span data-theme-toggle-label>Dark</span>
</button>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const button = document.querySelector('[data-theme-toggle]');
    const label = document.querySelector('[data-theme-toggle-label]');
    if (!button || !label) return;

    const render = () => {
      // Label the action, not the state: "Dark" while in dark mode reads as both.
      const isLight = root.dataset.theme === 'light';
      label.textContent = isLight ? 'Dark' : 'Light';
      button.setAttribute('aria-label', `Switch to ${isLight ? 'dark' : 'light'} appearance`);
      button.setAttribute('aria-pressed', String(isLight));
    };

    button.addEventListener('click', () => {
      root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light';
      try {
        localStorage.setItem('theme', root.dataset.theme);
      } catch {
        // Private mode / blocked storage: the toggle still works for this page view.
      }
      render();
    });

    render();
  })();
</script>

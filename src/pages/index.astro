---
import BaseLayout from '../layouts/BaseLayout.astro';
import FocusCard from '../components/FocusCard.astro';
import Hero from '../components/Hero.astro';
import PubRow from '../components/PubRow.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { profile } from '../data/profile';
import { TOPICS, publications } from '../data/publications';

// One reverse-chronological table, newest first — the order a reviewer expects
// when they are doing retrieval rather than reading.
const ordered = [...publications].sort(
  (a, b) =>
    Number(b.year) - Number(a.year) ||
    (a.featuredOrder ?? 99) - (b.featuredOrder ?? 99),
);
---

<BaseLayout>
  <header class="topbar">
    <a href="#top" class="wordmark">{profile.name}</a>
    <nav aria-label="Site navigation">
      <a href="#focus">Focus</a>
      <a href="#work">Publications</a>
      <a href="#about">About</a>
      <a href={`mailto:${profile.email}`}>Contact</a>
      <ThemeToggle />
    </nav>
  </header>

  <main>
    <Hero />

    <section class="section section--tight" id="focus" aria-labelledby="focus-heading">
      <h2 class="section__label" id="focus-heading">Current focus</h2>
      <div class="focus-grid">
        {profile.currentFocus.map((area, index) => <FocusCard {...area} index={index} />)}
      </div>
    </section>

    <section class="section" id="work" aria-labelledby="work-heading">
      <div class="section__bar">
        <h2 class="section__label" id="work-heading">Publications</h2>
        <div class="filters" role="group" aria-label="Filter publications by topic">
          <button class="filter is-on" type="button" data-topic="all">All</button>
          {TOPICS.map((topic) => (
            <button class="filter" type="button" data-topic={topic}>{topic}</button>
          ))}
        </div>
      </div>
      <ul class="pub-table" data-pub-table>
        {ordered.map((publication) => <PubRow publication={publication} />)}
      </ul>
      <p class="filters__empty" data-filter-empty hidden>No publications under this topic.</p>
    </section>

    <section class="section section--bio" id="about" aria-labelledby="about-heading">
      <h2 class="section__label" id="about-heading">About</h2>
      <p>{profile.biography}</p>
    </section>
  </main>

  <footer class="footer">
    <p>{profile.name} · {profile.affiliation} · {profile.location}</p>
    <div class="link-row link-row--tight">
      {
        profile.links.map((link) => (
          <a class="chip chip--sm" href={link.href}>
            {link.label}
          </a>
        ))
      }
    </div>
  </footer>
</BaseLayout>

<script is:inline>
  (() => {
    const table = document.querySelector('[data-pub-table]');
    const empty = document.querySelector('[data-filter-empty]');
    const buttons = [...document.querySelectorAll('.filter')];
    if (!table || !buttons.length) return;

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const topic = button.dataset.topic;
        buttons.forEach((other) => other.classList.toggle('is-on', other === button));

        let shown = 0;
        for (const row of table.children) {
          const topics = (row.dataset.topics || '').split('|');
          const match = topic === 'all' || topics.includes(topic);
          row.hidden = !match;
          if (match) shown += 1;
        }
        if (empty) empty.hidden = shown > 0;
      });
    });
  })();
</script>

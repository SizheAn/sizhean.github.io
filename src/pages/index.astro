---
import BaseLayout from '../layouts/BaseLayout.astro';
import FocusCard from '../components/FocusCard.astro';
import Hero from '../components/Hero.astro';
import PublicationCard from '../components/PublicationCard.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { profile } from '../data/profile';
import { featuredWork, otherPublications } from '../data/publications';
---

<BaseLayout>
  <header class="topbar">
    <a href="#top" class="wordmark">{profile.name}</a>
    <nav aria-label="Site navigation">
      <a href="#about">About</a>
      <a href="#focus">Focus</a>
      <a href="#work">Work</a>
      <a href={`mailto:${profile.email}`}>Contact</a>
      <ThemeToggle />
    </nav>
  </header>

  <main>
    <Hero />

    <section class="section section--bio" id="about" aria-labelledby="about-heading">
      <h2 class="section__label" id="about-heading">About</h2>
      <p>{profile.biography}</p>
    </section>

    <section class="section" id="focus" aria-labelledby="focus-heading">
      <h2 class="section__label" id="focus-heading">Current focus</h2>
      <div class="focus-grid">
        {profile.currentFocus.map((area, index) => <FocusCard {...area} index={index} />)}
      </div>
    </section>

    <section class="section" id="work" aria-labelledby="work-heading">
      <h2 class="section__label" id="work-heading">Selected work</h2>
      <div class="work-grid">
        {featuredWork.map((publication) => <PublicationCard publication={publication} />)}
      </div>
    </section>

    <section class="section" id="earlier" aria-labelledby="earlier-heading">
      <h2 class="section__label" id="earlier-heading">Earlier work</h2>
      <ul class="pub-list">
        {
          otherPublications.map((publication) => (
            <li>
              <span class="pill">{publication.venue} {publication.year}</span>
              <div>
                <p class="pub-list__title">{publication.title}</p>
                <p class="pub-list__authors">{publication.authors}</p>
              </div>
              <div class="link-row link-row--tight">
                {publication.links.map((link) => (
                  <a class="chip chip--sm" href={link.href}>
                    {link.label}
                  </a>
                ))}
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <footer class="footer">
    <p>{profile.name} · {profile.affiliation} · {profile.location}</p>
    <div class="link-row link-row--tight">
      {
        profile.links
          .filter((link) => !link.pending)
          .map((link) => (
            <a class="chip chip--sm" href={link.href}>
              {link.label}
            </a>
          ))
      }
    </div>
  </footer>
</BaseLayout>

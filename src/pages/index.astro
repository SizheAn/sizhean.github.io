---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { profile } from '../data/profile';
import { authorRole, isPeerReviewed, publications, venueTally } from '../data/publications';

// Wall order: embodiment proximity first, then everything else by recency.
const wall = [...publications].sort(
  (a, b) =>
    (a.featuredOrder ?? 99) - (b.featuredOrder ?? 99) || b.posted.localeCompare(a.posted),
);

// Dated liveness signal, derived from verified arXiv submission months.
const now = [...publications]
  .sort((a, b) => b.posted.localeCompare(a.posted))
  .slice(0, 4);

const months = [
  'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
  'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec',
];
const stamp = (posted: string) => {
  const [year, month] = posted.split('-');
  return `${months[Number(month) - 1]} ${year}`;
};

// "NeurIPS Datasets & Benchmarks 2022" swamps a tile bar; the short form is enough
// at wall scale and the full venue is in the detail panel.
const shortVenue = (venue: string) => venue.split(' ')[0];

const venues = venueTally();
const years = new Date().getFullYear() - profile.since.year;

// Detail lives in a data island so the wall itself stays chrome-free.
const details = Object.fromEntries(
  publications.map((publication) => [
    publication.slug,
    {
      title: publication.title,
      venue: `${publication.venue} ${publication.year}`,
      refereed: isPeerReviewed(publication),
      role: authorRole(publication),
      authors: publication.authors,
      contribution: publication.contribution,
      links: publication.links,
    },
  ]),
);
---

<BaseLayout>
  <div class="wall-layout">
    <aside class="rail" id="top">
      <div class="rail__inner">
        <div class="rail__head">
          <p class="wordmark">{profile.name}</p>
          <ThemeToggle />
        </div>
        <p class="eyebrow">{profile.role} · {profile.affiliation} · {profile.location}</p>

        <p class="rail__lead">{profile.positioning.lead}</p>
        <p class="rail__statement">{profile.positioning.statement}</p>
        <p class="rail__bridge">{profile.bridge}</p>

        <ul class="rail__metrics" aria-label="Publication record">
          {venues.map((venue) => <li>{venue.label}{venue.count > 1 && ` ×${venue.count}`}</li>)}
          <li><a href={profile.github.repo}>{profile.github.label} ★{profile.github.stars.toLocaleString('en-US')}</a></li>
          <li>{years} yrs @ {profile.since.label}</li>
        </ul>

        <div class="link-row link-row--tight">
          {profile.links.map((link) => <a class="chip chip--sm" href={link.href}>{link.label}</a>)}
        </div>

        <h2 class="rail__label">Now</h2>
        <ul class="rail__now">
          {now.map((publication) => (
            <li>
              <span>{stamp(publication.posted)}</span>
              <a href={`#${publication.slug}`}>{publication.shortTitle}</a>
              <em>{isPeerReviewed(publication) ? publication.venue : 'preprint'}</em>
            </li>
          ))}
        </ul>
      </div>
    </aside>

    <main class="wall" aria-label="Results">
      {
        wall.map((publication, index) => (
          <button
            class:list={['cell', index === 0 && 'cell--wide']}
            type="button"
            id={publication.slug}
            data-slug={publication.slug}
            aria-haspopup="dialog"
          >
            {publication.media.type === 'video' ? (
              <video
                src={publication.media.src}
                poster={publication.media.poster}
                playsinline
                muted
                loop
                preload="none"
                aria-hidden="true"
                data-autoplay
              />
            ) : (
              <img src={publication.media.src} alt="" loading="lazy" decoding="async" />
            )}
            <span class="cell__bar">
              <span class:list={['pill', isPeerReviewed(publication) ? 'pill--refereed' : 'pill--preprint']}>
                {shortVenue(publication.venue)} {publication.year}
              </span>
              <span class="cell__name">{publication.shortTitle}</span>
            </span>
          </button>
        ))
      }
    </main>
  </div>

  <div class="detail" data-detail hidden>
    <div class="detail__scrim" data-detail-close></div>
    <div class="detail__panel" role="dialog" aria-modal="true" aria-labelledby="detail-title">
      <button class="detail__close" type="button" data-detail-close aria-label="Close">×</button>
      <div class="detail__meta">
        <span class="pill" data-detail-venue></span>
        <span class="role" data-detail-role></span>
      </div>
      <h3 id="detail-title" data-detail-title></h3>
      <p class="detail__authors" data-detail-authors></p>
      <p class="detail__contribution" data-detail-contribution></p>
      <div class="link-row link-row--tight" data-detail-links></div>
    </div>
  </div>

  <script is:inline type="application/json" data-detail-source set:html={JSON.stringify(details)} />
</BaseLayout>

<script is:inline>
  (() => {
    const source = document.querySelector('[data-detail-source]');
    const panel = document.querySelector('[data-detail]');
    if (!source || !panel) return;
    const data = JSON.parse(source.textContent || '{}');

    const el = (name) => panel.querySelector(`[data-detail-${name}]`);
    const venue = el('venue');
    const role = el('role');
    const title = el('title');
    const authors = el('authors');
    const contribution = el('contribution');
    const links = el('links');

    const close = () => {
      panel.hidden = true;
      document.body.style.overflow = '';
    };

    const open = (slug) => {
      const item = data[slug];
      if (!item) return;
      venue.textContent = item.venue;
      venue.className = `pill ${item.refereed ? 'pill--refereed' : 'pill--preprint'}`;
      role.textContent = item.role.label;
      role.className = `role ${item.role.strong ? 'role--strong' : ''}`;
      title.textContent = item.title;
      authors.textContent = item.authors;
      contribution.textContent = item.contribution;
      links.replaceChildren(
        ...item.links.map((link) => {
          const a = document.createElement('a');
          a.className = 'chip chip--sm';
          a.href = link.href;
          a.textContent = link.label;
          return a;
        }),
      );
      panel.hidden = false;
      document.body.style.overflow = 'hidden';
    };

    document.querySelectorAll('.cell').forEach((cell) => {
      cell.addEventListener('click', () => open(cell.dataset.slug));
    });
    panel.querySelectorAll('[data-detail-close]').forEach((node) => {
      node.addEventListener('click', close);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) close();
    });
  })();
</script>

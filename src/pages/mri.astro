---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { publications } from '../data/publications';

const publication = publications.find((item) => item.slug === 'mri');
if (!publication) {
  throw new Error('mRI publication data missing');
}
---

<BaseLayout title="mRI — Sizhe An" description={publication.summary}>
  <header class="topbar topbar--simple">
    <a href="/" class="wordmark">Sizhe An</a>
    <nav aria-label="Project navigation">
      <a href="/">Home</a>
      <a href="/panohead/">PanoHead</a>
      <ThemeToggle />
    </nav>
  </header>
  <main class="project-page">
    <p class="eyebrow">Legacy project preserved in the new portfolio</p>
    <h1>{publication.title}</h1>
    <PublicationCard publication={publication} />
  </main>
</BaseLayout>
